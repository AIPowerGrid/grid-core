# AI Power Grid — production environment template
# Copy to /etc/aipg/grid.env (chmod 600, owned by aipg) and fill in.
# The legacy bootstrap is quarantined and does not define the current deploy
# contract. Generate secrets explicitly before installing this file.
#
# Sections marked [REQUIRED] must be set for that feature to work.
# Sections marked [OPTIONAL] degrade gracefully if unset.

# ════════════════════════════════════════════════════════════════════
# [REQUIRED] Core secrets — app refuses to boot without GRID_SALT
# ════════════════════════════════════════════════════════════════════
# API-key salt shared by server processes that validate the same hashes. Never
# expose this to the browser or developer-console deployment.
# Generate: openssl rand -hex 32
GRID_SALT=__GENERATE_ME__

# ════════════════════════════════════════════════════════════════════
# [REQUIRED] Postgres
# ════════════════════════════════════════════════════════════════════
POSTGRES_USER=aipg
POSTGRES_PASS=__GENERATE_ME__
# host:port/dbname  (NOTE: no inline comments after values — systemd
# EnvironmentFile keeps them as part of the value, which breaks the DB name)
POSTGRES_URL=127.0.0.1:5432/aipg_grid

# ════════════════════════════════════════════════════════════════════
# [REQUIRED] Redis
# ════════════════════════════════════════════════════════════════════
# Grid uses DB 7 for streams, pub/sub, quota, and rate limiting.
REDIS_IP=127.0.0.1
REDIS_PORT=6379
REDIS_STREAM_DB=7

# FastAPI bind and transport deadlines. systemd may also pass host/port on the
# uvicorn command line; keep the two sources aligned.
GRID_API_HOST=0.0.0.0
GRID_API_PORT=7002
JOB_TIMEOUT_SECONDS=300
WORKER_PING_INTERVAL=30
STREAM_SUBSCRIBE_TIMEOUT=300

# ════════════════════════════════════════════════════════════════════
# [REQUIRED for image/video] R2 / S3 object storage
# ════════════════════════════════════════════════════════════════════
# Without these, generated media has nowhere to go. Use Cloudflare R2
# (S3-compatible) or another compatible object store.
#
# *_ACCOUNT is the S3 endpoint URL (NOT just an account id). For R2 use the
# account/jurisdiction endpoint: https://<accountid>.r2.cloudflarestorage.com
R2_TRANSIENT_ACCOUNT=
R2_TRANSIENT_BUCKET=
R2_PERMANENT_ACCOUNT=
R2_PERMANENT_BUCKET=
R2_SOURCE_IMAGE_BUCKET=
# Use an R2 token with Object Read & Write on only these buckets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SHARED_AWS_ACCESS_ID=
SHARED_AWS_ACCESS_KEY=

# ════════════════════════════════════════════════════════════════════
# Native user sessions and bounded service accounts
# ════════════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
GRID_USER_TOKEN_SIGNING_KEY=
# Optional emergency/bootstrap HTTP provisioning secret. Prefer the local
# scripts/create_service_account.py CLI and leave this unset in steady state.
#GRID_SERVICE_BOOTSTRAP_TOKEN=
# Legacy rollout escape hatches. Keep off after clients use native exchange.
GRID_LEGACY_INTERNAL_SESSION_ENABLED=0
GRID_LEGACY_SESSION_KEYS_ENABLED=0
#GRID_INTERNAL_TOKEN=

# Demand charging is independently gated and defaults dark. GRID_CHARGING_MODE
# is authoritative when set. The old boolean remains an emergency-compatible
# fallback for hosts that have not adopted the mode yet.
GRID_CHARGING_MODE=off

# Optional immutable deployment identity for gitless images/source archives.
# Managed detached release checkouts self-report HEAD; leave this empty there.
GRID_BUILD_COMMIT=
GRID_CHARGING_ENABLED=0
# In allowlist mode, user/delegated work matches only by account. A service ID
# matches only a direct service key carrying inference.service_submit; listing a
# frontend service never selects all users behind it. The optional model list
# narrows the cohort further and never enables charging by itself.
GRID_CHARGING_ALLOW_ACCOUNTS=
GRID_CHARGING_ALLOW_SERVICES=
GRID_CHARGING_ALLOW_MODELS=
GRID_FREE_CREDITS_ENABLED=1
GRID_FREE_SPENDABLE_LIVE=0
GRID_PROMO_CREDITS_ENABLED=1
GRID_PROMO_SPENDABLE_LIVE=0
GRID_WELCOME_CAMPAIGN_ID=universal-welcome-v1
GRID_WELCOME_GRANT_MICRO=100000
GRID_WELCOME_EXPIRES_DAYS=30
# Hard campaign ceiling ($500 at micro-USD precision). Wallet creation alone
# never qualifies for this grant; Core requires a verified Google identity.
GRID_WELCOME_BUDGET_MICRO=500000000
GRID_DEPOSITS_ENABLED=0

# Managed ACE-Step/audio is independently gated from charging. An exact-digest
# signed pilot may be approved after its own hardware qualification; publishing
# a public manager profile still requires the full three-tier matrix and
# RecipeVault provenance. Profile approval alone does not enable this route.
AUDIO_ENABLED=0
APPROVED_WORKER_PROFILE_DIGESTS=
REQUIRE_WORKER_IDENTITY=0
WORKER_ENROLLMENT_ENABLED=0
WORKER_ENROLLMENT_CONSOLE_URL=https://console.aipowergrid.io/dashboard/connect-worker
# Strict wallet login: frontend origin allowlist for EIP-4361 challenges.
GRID_SIWE_ALLOWED_DOMAINS=console.aipowergrid.io,aipg.art,aipg.chat,aipg.music
# Emergency migration switch only. Keep off once clients use /wallet/challenge.
GRID_LEGACY_SIWE_VERIFY_ENABLED=0
WORKER_ENROLLMENT_TTL_SECONDS=900

# Optional validator -> human account visibility. Deploy Alembic 0030, the
# Console approval page and compatible node app before enabling. Does not
# transfer accounts, issue credentials, change payout wallets or enable rewards.
VALIDATOR_PAIRING_ENABLED=0
# Optional supervised pilot while global pairing remains off. JSON array of
# at most 10 canonical node AND human account UUIDs; default admits nobody.
# Private operational IDs: keep real values only in the protected runtime env.
VALIDATOR_PAIRING_CANARY_ACCOUNTS=[]
# Required for a non-empty pilot; ISO-8601 with timezone, at most 24h ahead at
# startup. Omit when unused. Expiry stops access without deleting associations.
# VALIDATOR_PAIRING_CANARY_UNTIL=<explicit-UTC-deadline>
VALIDATOR_PAIRING_AUDIENCE=https://api.aipowergrid.io
VALIDATOR_PAIRING_CONSOLE_URL=https://console.aipowergrid.io/dashboard/connect-validator

# Atomic reservation cleanup.
RESERVATION_SWEEP_SECONDS=300
RESERVATION_STALE_SECONDS=3600
GRID_BILLING_MONITOR_SECONDS=300
GRID_BILLING_HELD_WARNING_SECONDS=900

# Operator alerts. Store the real value only in the protected production env;
# never commit it, paste it into logs, or expose it to a frontend.
GRID_ALERT_DISCORD_WEBHOOK=
GRID_ALERT_QUEUE_SIZE=256
GRID_ALERT_DEDUPE_SECONDS=300

# Public request/concurrency bounds.
GRID_TEXT_CONCURRENCY=24
MEDIA_CONCURRENCY=4
MAX_REQUEST_CHARS=200000
MAX_REQUEST_MESSAGES=500
MAX_PASSTHROUGH_CHARS=200000
MAX_PASSTHROUGH_DEPTH=64

# Validator preview. Evidence has no economic authority.
VALIDATOR_ASSIGNMENT_TTL_SECONDS=900
VALIDATOR_PROBE_TIMEOUT_SECONDS=180
VALIDATOR_PROBE_MAX_ATTEMPTS=2
VALIDATOR_PROBE_LEASE_SECONDS=240
VALIDATOR_PROBE_MAX_TOKENS=512
VALIDATOR_PROBE_LATENCY_BUDGET_SECONDS=30
VALIDATOR_ATTESTATION_GRACE_SECONDS=1800
VALIDATOR_HEARTBEAT_FRESH_SECONDS=900
VALIDATOR_QUORUM_MIN=3
VALIDATOR_QUORUM_TARGET=5
# Economically inert text probes are still real GPU work. Core permits at most
# one new text probe group per worker/model in this interval. Finalized
# assignment/group operational rows are pruned after the scorecard API's
# maximum 90-day window; signed attestation evidence remains append-only.
VALIDATOR_TEXT_GROUP_MIN_INTERVAL_SECONDS=3600
VALIDATOR_HISTORY_RETENTION_DAYS=90
VALIDATOR_HISTORY_SWEEP_SECONDS=21600

# Live custodial payout sender. Keep private keys blank in the template and
# inject them through the production secret path.
BASE_RPC_URL=
AIPG_TOKEN_ADDRESS=0xa1c0deCaFE3E9Bf06A5F29B7015CD373a9854608
SETTLEMENT_TREASURY_PK=
PAYOUT_MIN_AIPG=0.01
# Consumed by scripts/payout_hourly.sh (208.33 ~= 5,000 AIPG/day).
PAYOUT_HOURLY_BUDGET=208.33

# ════════════════════════════════════════════════════════════════════
# [OPTIONAL] Demand credits, deposits, and holder policy
# ════════════════════════════════════════════════════════════════════
# Displayed daily allowance. The base requires verified Google. Holder value is
# disabled until qualification cannot be recycled between wallets. Neither
# pocket is spendable while the live gate is off.
GRID_FREE_DAILY_MICRO=10000
GRID_FREE_HOLDER_MIN_AIPG=100000
GRID_FREE_HOLDER_BONUS_MICRO=0

# Off unless a reviewed pricing/top-up rollout enables them.
GRID_HOLDER_DISCOUNT_ENABLED=0
GRID_HOLDER_DISCOUNT_BPS=2500
GRID_HOLDER_MIN_AIPG=100000
GRID_HOLDINGS_TTL=600
GRID_ETH_PRICE_TTL=60

# Base funding remains disabled while GRID_DEPOSITS_ENABLED=0. USDC is the
# launch rail. AIPG additionally requires its own switch plus a fresh,
# conservative operator price epoch. Direct ETH remains disabled until an
# explicit conversion policy is selected.
GRID_BASE_CHAIN_ID=8453
GRID_BASE_RPC=https://mainnet.base.org
GRID_USDC_CONTRACT=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
GRID_USDC_TREASURY=
GRID_DEPOSIT_CONFIRMATIONS=3
GRID_DEPOSIT_MIN_MICRO=10000
GRID_USDC_MAX_DEPOSIT_MICRO=10000000000
GRID_USDC_ACCOUNT_DAILY_MICRO=25000000000
GRID_USDC_NETWORK_DAILY_MICRO=100000000000

GRID_AIPG_DEPOSITS_ENABLED=0
GRID_AIPG_TOKEN=0xa1c0deCaFE3E9Bf06A5F29B7015CD373a9854608
GRID_AIPG_TREASURY=
GRID_AIPG_DECIMALS=18
GRID_AIPG_CREDIT_PRICE_MICRO=0
GRID_AIPG_PRICE_EPOCH=
GRID_AIPG_PRICE_AS_OF=
GRID_AIPG_PRICE_VALID_UNTIL=
GRID_AIPG_PRICE_BLOCK=0
GRID_AIPG_PRICE_MAX_AGE_SECONDS=86400
GRID_AIPG_DEPOSIT_HAIRCUT_BPS=300
GRID_AIPG_MAX_DEPOSIT_MICRO=100000000
GRID_AIPG_ACCOUNT_DAILY_MICRO=100000000
GRID_AIPG_NETWORK_DAILY_MICRO=500000000

# Direct ETH is intentionally unavailable while this is "disabled".
# "swap_receipt" credits only actual canonical-USDC proceeds delivered by a
# linked-wallet ETH swap and is the production policy. "buffered" is a capped,
# operator-only oracle pilot and must not be exposed in the public Console.
GRID_ETH_CONVERSION_MODE=disabled
GRID_ETH_TREASURY=
GRID_ETH_DEPOSIT_HAIRCUT_BPS=100
GRID_ETH_MAX_DEPOSIT_MICRO=100000000
GRID_ETH_ACCOUNT_DAILY_MICRO=100000000
GRID_ETH_NETWORK_DAILY_MICRO=500000000
GRID_ETH_USD_FEED=0x71041dddad3595f9ced3dccfbe3d1f4b0a16bb70
GRID_ETH_USD_FEED_DECIMALS=8

# Accountless agent payments. Default-off and text/non-streaming only in the
# initial rail. The payer authorizes up to $1 USDC; Core settles actual
# grid-counted usage. Base mainnet requires CDP facilitator credentials.
GRID_X402_ENABLED=0
GRID_X402_NETWORK=eip155:8453
GRID_X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
GRID_X402_PAY_TO=
GRID_X402_MAX_AUTH_MICRO=1000000
GRID_X402_DEFAULT_MAX_TOKENS=4096
# A pre-settlement attempt without a durable receipt becomes manual_review
# after this interval. Core never blindly retries an ambiguous Permit2 nonce.
GRID_X402_STALE_SECONDS=900
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ════════════════════════════════════════════════════════════════════
# [OPTIONAL] Pricing and future multi-asset payout policy
# ════════════════════════════════════════════════════════════════════
# Preference storage exists, but the live payout CLI ignores asset choice while
# routing is 0 and continues to pay the fixed AIPG budget above.
GRID_PAYOUT_ASSET_ROUTING=0
GRID_DEFAULT_PAYOUT_ASSET=USDC
GRID_PROTOCOL_FEE_BPS=1200
GRID_SENTINEL_FEE_BPS=300
GRID_WORKER_AIPG_SHARE_BPS=0
GRID_PAYOUT_CONVERSION_FEE_BPS=50
GRID_PAYOUT_FEE_TO_BUYBACK=1
GRID_AIPG_PAYMENT_BONUS_BPS=0
GRID_BUYBACK_ENABLED=0
GRID_BUYBACK_MAX_PER_EPOCH_MICRO=0

# ════════════════════════════════════════════════════════════════════
# [OPTIONAL] Queue, media, recipes, routing, and internal probes
# ════════════════════════════════════════════════════════════════════
GRID_DEFAULT_MAX_TOKENS=32768
GRID_JOB_STREAM_MAXLEN=10000
MEDIA_MAX_STEPS=80
MEDIA_MAX_CFG_SCALE=30
GRID_MEDIA_BASE_URL=https://media.aipg.art

# Local recipes load regardless. RecipeVault authority is separately gated and
# stays off unless every field below is reviewed. Address configuration alone
# does nothing; Core never falls back to GRID_DIAMOND_ADDRESS. Two independent
# RPC hosts must agree on one finalized snapshot, and the verifier label pins a
# facet runtime compiled into this Core release. MODELVAULT_ADDRESS is not wired.
RECIPEVAULT_SYNC_ENABLED=0
RECIPEVAULT_ADDRESS=
RECIPEVAULT_CONFIRMATION_RPC_URL=
RECIPEVAULT_VERIFIER_VERSION=
RECIPEVAULT_CHAIN_ID=8453
RECIPEVAULT_MAX_RECORDS=256
RECIPEVAULT_MAX_WORKFLOW_BYTES=262144
RECIPEVAULT_RPC_TIMEOUT_SECONDS=20
RECIPEVAULT_MAX_FINALIZED_AGE_SECONDS=1800
RECIPEVAULT_MAX_STALE_SECONDS=1800
MODELVAULT_ADDRESS=
RECIPE_SYNC_SECONDS=600

# Core-owned canary probes are separate from external validator assignments and
# remain dark unless explicitly enabled.
GRID_PROBE_ENABLED=0
GRID_PROBE_INTERVAL=300
GRID_PROBE_MAX_TOKENS=24
GRID_PROBE_TIMEOUT=60
GRID_PROBE_SIGNING_KEY=

# Dark compatibility gate. Updated validators can verify a commitment without
# learning the target, model, nonce, or prompt before the probe completes.
# Enable only after every participating validator runs a compatible release.
VALIDATOR_SEALED_ASSIGNMENTS_ENABLED=0

# Assignment-bound deterministic image validation. Keep disabled until the
# reviewed cooldown-backed WorkerRegistry is deployed, the finalized bond sync
# has populated an independently reviewed reference pool, and deterministic
# RecipeVault metadata includes a modelDigest. These probes are non-economic.
VALIDATOR_MEDIA_PROBE_ENABLED=0
# Independent dark gate for objective video container/timing/motion probes.
# It still requires VALIDATOR_MEDIA_PROBE_ENABLED=1 and a governed recipe.
VALIDATOR_VIDEO_PROBE_ENABLED=0
VALIDATOR_MEDIA_BOND_CHAIN_ID=8453
# Reviewed Grid Diamond proxy. The sync independently verifies every
# WorkerRegistry selector route and the routed facet runtime hash.
VALIDATOR_MEDIA_BOND_CONTRACT=
# A separately operated provider. The cache pins both sources to their newest
# mutually finalized block and updates only when its hash and complete bond
# snapshot agree exactly.
VALIDATOR_MEDIA_BOND_CONFIRMATION_RPC_URL=
# Must name a verifier/runtime pair compiled into this Core release. Operators
# cannot redefine a verifier by supplying an arbitrary runtime hash.
# Current reviewed source candidate (do not enable until deployed and verified):
# Current reviewed candidate: worker-registry-v2-7d7a2e8
# Historical compatible candidate: worker-registry-v2-957685a
VALIDATOR_MEDIA_BOND_VERIFIER_VERSION=
VALIDATOR_MEDIA_MINIMUM_BOND_RAW=0
VALIDATOR_MEDIA_BOND_SYNC_ENABLED=0
VALIDATOR_MEDIA_BOND_SYNC_SECONDS=300
VALIDATOR_MEDIA_BOND_RPC_TIMEOUT_SECONDS=20
# Maximum distinct pre-reviewed reference wallets queried per snapshot. This is
# not a cap on the global on-chain WorkerRegistry.
VALIDATOR_MEDIA_BOND_MAX_WORKERS=10000
VALIDATOR_MEDIA_MINIMUM_QUALITY_PASS_RATE=0.95
VALIDATOR_MEDIA_MAX_OUTPUT_BYTES=26214400
VALIDATOR_MEDIA_PROBE_TIMEOUT_SECONDS=600

# Optional routing policy files/pins. Empty values use built-in behavior.
GRID_ROUTING_CONFIG=
GRID_ROUTING_PIN=
GRID_ROUTING_SCORE_TTL=15
GRID_ROUTING_SCORE_WINDOW_H=24

# ════════════════════════════════════════════════════════════════════
# [DEVELOPMENT ONLY] default-off P2P prototype
# ════════════════════════════════════════════════════════════════════
